# Documents which variables each stack needs. Nothing reads this file —
# the values are set per-stack in Portainer, under "Environment variables",
# and live on the NAS rather than in git.

# ---- stacks/traefik ----
# Cloudflare API token for the DNS-01 ACME challenge.
# https://dash.cloudflare.com/profile/api-tokens -> Create Custom Token
#
# Needs BOTH permissions, scoped to gt3.dev:
#   Zone -> Zone -> Read    (lego resolves the domain to a zone id first)
#   Zone -> DNS  -> Edit    (writes the _acme-challenge TXT record)
#
# DNS:Edit alone fails with "No TXT record found at _acme-challenge.gt3.dev",
# which looks like a propagation problem and isn't. Not the Global API Key.
CF_DNS_API_TOKEN=

# The ACME email is a command flag in the compose, not a variable — Traefik's
# static config sources are mutually exclusive, so an env var would be ignored.

# ---- stacks/immich ----
# Don't set IMMICH_VERSION. The version is pinned in the compose file and
# Renovate bumps it; an env var here would silently override that.
UPLOAD_LOCATION=
DB_DATA_LOCATION=
DB_PASSWORD=
DB_USERNAME=
DB_DATABASE_NAME=

# ---- stacks/media-stack ----
RD_API_KEY=

# ---- stacks/tailscale ----
# Only used on first registration; after that the node's identity lives in the
# tailscale-state volume. Generate at Settings -> Keys in the admin console.
TS_AUTHKEY=

# ---- stacks/sure ----
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
# Only read when the postgres-data volume is first initialised. Changing it
# later doesn't change the database's password.
POSTGRES_PASSWORD=
