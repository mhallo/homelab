# ---------------------------------------------------------------------------
# Example environment file. Copy to .env for LOCAL testing only.
#
# IMPORTANT: For stacks deployed through Portainer (git-backed), these are NOT
# read from this file. You set them in Portainer under the stack's
# "Environment variables" section. They live on the NAS, never in git.
#
# This file exists to document WHICH variables each stack requires.
# ---------------------------------------------------------------------------

# ---- stacks/traefik ----
# Cloudflare API token used for the DNS-01 ACME challenge.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone -> DNS -> Edit
# Zone Resources: Include -> Specific zone -> gt3.dev
# Do NOT use a Global API Key.
CF_DNS_API_TOKEN=paste-scoped-token-here

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# ---- stacks/immich ----
# Already set in Portainer today. Copy the existing values across when migrating.
UPLOAD_LOCATION=
DB_DATA_LOCATION=
IMMICH_VERSION=release
DB_PASSWORD=
DB_USERNAME=
DB_DATABASE_NAME=

# ---- stacks/media-stack ----
# Already set in Portainer today.
RD_API_KEY=

# ---- stacks/tailscale ----
# NOT currently set in Portainer -- the key is hardcoded in the running stack.
# Must be created in Portainer BEFORE deploying the scrubbed version from git.
# See stacks/tailscale/docker-compose.yml for the state-directory warning.
TS_AUTHKEY=
